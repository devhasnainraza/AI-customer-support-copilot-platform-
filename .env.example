# =============================================================================
# Supabase Configuration
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# Groq AI Configuration
# =============================================================================
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-70b-versatile

# =============================================================================
# OpenAI Configuration (required for embeddings / RAG + ingestion)
# =============================================================================
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# Kafka Configuration
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=ai-copilot-consumer-group

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# Frontend
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# =============================================================================
# Security Configuration
# =============================================================================
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# OpenTelemetry Configuration
# =============================================================================
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ai-copilot
OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces
OTEL_EXPORTER_PROMETHEUS_PORT=8001

# =============================================================================
# Worker Configuration
# =============================================================================
AI_INFERENCE_WORKER_CONCURRENCY=10
INGESTION_WORKER_CONCURRENCY=5
NOTIFICATION_WORKER_CONCURRENCY=3

# =============================================================================
# Document Processing Configuration
# =============================================================================
MAX_UPLOAD_SIZE_MB=10
SUPPORTED_LANGUAGES=en,es,fr
DEFAULT_LANGUAGE=en

# Chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# =============================================================================
# Embedding Configuration
# =============================================================================
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# =============================================================================
# Notification Configuration (Optional)
# =============================================================================
# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# Slack
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_MULTI_LANGUAGE=true
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
